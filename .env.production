# Production Environment Variables
# This file is loaded when NODE_ENV=production
# Safe to commit this file (no secrets)

# Application Configuration
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=window.location.origin

# Analytics (production values)
# NEXT_PUBLIC_GA_TRACKING_ID=GA_MEASUREMENT_ID
# NEXT_PUBLIC_MIXPANEL_TOKEN=PRODUCTION_TOKEN

# Email Service (production values)
# EMAILJS_SERVICE_ID=PRODUCTION_SERVICE_ID
# EMAILJS_TEMPLATE_ID=PRODUCTION_TEMPLATE_ID
# EMAILJS_PUBLIC_KEY=PRODUCTION_PUBLIC_KEY

# Social Media Links
# NEXT_PUBLIC_GITHUB_URL=https://github.com/kush11251
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/kush11251

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EMAIL_CONTACT=true

# API Endpoints
NEXT_PUBLIC_API_BASE_URL=https://my-json-server-l3s3.onrender.com