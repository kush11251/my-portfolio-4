# Development Environment Variables
# This file is for local development only
# Do not commit this file to version control

# Application Configuration
# NEXT_PUBLIC_APP_ENV=development  # Removed to allow production override
NEXT_PUBLIC_APP_URL=window.location.origin

# Analytics (if using)
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Email Service (if using)
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=

# Social Media Links (can be overridden in data.json)
# NEXT_PUBLIC_GITHUB_URL=https://github.com/kush11251
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/kush11251

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_EMAIL_CONTACT=true

# API Endpoints
NEXT_PUBLIC_API_BASE_URL=https://my-json-server-l3s3.onrender.com